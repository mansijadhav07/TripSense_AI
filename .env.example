# TripSense AI - Environment Configuration Template
# Copy this file to .env and fill in actual values

# ============================================
# Database Configuration
# ============================================
DB_USER=tripsense_user
DB_PASSWORD=CHANGEME_SECURE_PASSWORD
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tripsense

# Database URL (constructed from above, or override)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ============================================
# API / Backend Configuration
# ============================================
# Secret key for JWT tokens - Generate with: openssl rand -hex 32
SECRET_KEY=CHANGEME_GENERATE_SECURE_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=info

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=TripSense AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================
# Data Paths
# ============================================
RAW_DATA_PATH=./data/raw/tripadvisor_reviews.csv
PROCESSED_DATA_PATH=./data/processed
MODEL_ARTIFACTS_PATH=./artifacts
REPORTS_PATH=./data/reports

# ============================================
# Apache Spark Configuration
# ============================================
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_APP_NAME=TripSense-AI-Pipeline

# ============================================
# ML Model Configuration
# ============================================
# Model training parameters
ALS_RANK=10
ALS_REG_PARAM=0.1
ALS_MAX_ITER=10

# Hybrid model weights
WEIGHT_COLLABORATIVE=0.35
WEIGHT_CONTENT=0.30
WEIGHT_ASPECT=0.20
WEIGHT_SENTIMENT=0.10
WEIGHT_POPULARITY=0.05

# Recommendation settings
DEFAULT_TOP_N=10
MIN_REVIEWS_FOR_POPULARITY=10

# ============================================
# Feature Engineering
# ============================================
TFIDF_MAX_FEATURES=500
MIN_RATING=1.0
MAX_RATING=5.0

# ============================================
# Evaluation
# ============================================
TEST_SIZE=0.2
RANDOM_SEED=42
PRECISION_K=10
RECALL_K=10
NDCG_K=10

# ============================================
# Optional: External Services
# ============================================
# Redis (if implemented)
# REDIS_URL=redis://localhost:6379/0

# Sentry (if implemented)
# SENTRY_DSN=

# AWS S3 (if implemented for data storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# ============================================
# Development vs Production
# ============================================
# development, staging, production
ENVIRONMENT=development

# Serve clearly-labelled SYNTHETIC demo hotels when no valid hotel catalogue exists.
# Leave false in production: the API then answers 503 instead of showing fake data.
ALLOW_SYNTHETIC_DATA=false
