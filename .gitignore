# TripSense AI - Git Ignore File

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Jupyter Notebooks
.ipynb_checkpoints
notebooks/.ipynb_checkpoints/

# Allow specific exploration notebooks
!notebooks/00_dataset_exploration.ipynb

# PyCharm
.idea/

# VSCode
.vscode/
*.code-workspace

# Spyder
.spyderproject
.spyproject

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytest
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ============================================
# Node.js / Next.js
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Next.js
.next/
out/
build/

# Testing
coverage/
.nyc_output/

# ============================================
# Environment Variables & Secrets
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
*.crt
*.p12
secrets/

# Keep example files
!.env.example

# ============================================
# Data Files (Large & Sensitive)
# ============================================
# Raw datasets
data/raw/*
!data/raw/.gitkeep

# Processed data
data/processed/*
!data/processed/.gitkeep

# Temporary data
data/temp/
data/cache/

# ============================================
# Model Artifacts & Experiments
# ============================================
# Trained models
artifacts/*
!artifacts/.gitkeep

# Model checkpoints
*.ckpt
*.pt
*.pth
*.h5
*.pkl
*.joblib
*.bin

# MLflow / Experiment tracking
mlruns/
mlflow/

# TensorBoard
runs/
logs/
tensorboard/

# Spark
spark-warehouse/
metastore_db/
derby.log

# ============================================
# Database
# ============================================
*.db
*.sqlite
*.sqlite3
postgres-data/

# ============================================
